<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    
    <connectionStrings>
        <!-- Clean connection string pointing directly to the LocalDB engine. No AttachDbFilename used. -->
        <add name="SortationDbConnection" 
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=SortationDB;Integrated Security=True;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>